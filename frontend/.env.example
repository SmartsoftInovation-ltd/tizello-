# Where the Tizello API lives. Read by src/lib/api-client.ts on the SERVER only
# (Server Components and Server Actions) — it is deliberately NOT prefixed
# NEXT_PUBLIC_, because the browser never talks to the API directly. It talks to
# Next, and Next holds the httpOnly session cookies.
#
# This must match the port the backend actually bound, which it prints at
# startup:
#
#   [server] API listening on http://127.0.0.1:5000 (development)
#
# If they disagree, every auth request silently goes to whatever else is on
# that port and sign-in / sign-up fail with "Something went wrong."
API_BASE_URL="http://localhost:5000/api/v1"

# Where uploaded files are served from, for the browser to load directly.
#
# NEXT_PUBLIC_, unlike API_BASE_URL above: the browser resolves this one. An
# <img src> cannot carry the app's session — the cookies are httpOnly on the
# Next origin — so attachments are read from the API's PUBLIC static mount
# (`app.use('/static', express.static(...))`) rather than from the
# authenticated GET /api/v1/uploads/:name.
#
# This must be the origin the BROWSER can reach, which is not always the one
# API_BASE_URL uses: in a container, the server may talk to `api:5001` while
# the browser needs `http://localhost:5001`.
NEXT_PUBLIC_UPLOADS_URL="http://localhost:5001/static"

# Where the BROWSER opens the notification socket. The API's own origin:
# Socket.IO is attached to the same HTTP server, so this is the API host
# without the /api/v1 path. NEXT_PUBLIC_ because the browser is what connects.
#
# It must be the origin the BROWSER can reach, which is not always the one
# API_BASE_URL uses: in a container the server may talk to `api:5001` while the
# browser needs `http://localhost:5001`.
NEXT_PUBLIC_SOCKET_URL="http://localhost:5001"
